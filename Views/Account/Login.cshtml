@* ============================================================
   Account/Login.cshtml
   Giriş ekranı. Layout kullanmıyorum burada çünkü taskbar
   giriş öncesi görünmesin. Klasik XP giriş penceresi gibi.
   ============================================================ *@
@model KurusMatik.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KuruşMatik - Giriş</title>
    <link rel="stylesheet" href="~/css/xp.css" />
    <style>
        /* Giriş ekranı için ekstra XP animasyonu */
        .xp-login-window { animation: xpAppear 0.3s ease; }
        @@keyframes xpAppear {
            from { transform: scale(0.92); opacity: 0; }
            to   { transform: scale(1);    opacity: 1; }
        }
        .xp-logo-area {
            text-align: center;
            color: white;
            margin-bottom: 8px;
        }
        .xp-logo-area .logo-icon { font-size: 48px; }
        .xp-logo-area h1 {
            font-family: Tahoma, sans-serif;
            font-size: 22px;
            font-weight: bold;
            text-shadow: 2px 2px 6px rgba(0,0,0,0.5);
            margin: 4px 0 0;
        }
        .xp-logo-area p { font-size: 11px; opacity: 0.8; }
    </style>
</head>
<body>
<div class="xp-login-desktop">

    <div class="xp-logo-area">
        <div class="logo-icon">💰</div>
        <h1>KuruşMatik</h1>
        <p>Kişisel Finans ve Bütçe Takip Sistemi</p>
    </div>

    <div class="xp-login-window">
        <div class="xp-titlebar">
            <span class="xp-titlebar-icon">🔐</span>
            <span class="xp-titlebar-text">Sisteme Giriş - KuruşMatik</span>
            <div class="xp-titlebar-buttons">
                <div class="xp-win-btn xp-win-btn-min">_</div>
                <div class="xp-win-btn xp-win-btn-max">□</div>
                <div class="xp-win-btn xp-win-btn-close">✕</div>
            </div>
        </div>
        <div class="xp-window-body" style="padding: 16px;">

            @* Validasyon hataları *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="xp-alert xp-alert-danger">
                    <span class="xp-alert-icon">❌</span>
                    <div>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="xp-form-group">
                    <label class="xp-label" asp-for="Email">📧 E-posta Adresi</label>
                    <input asp-for="Email" class="xp-input" type="email" autocomplete="username"
                           placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="xp-field-error"></span>
                </div>

                <div class="xp-form-group">
                    <label class="xp-label" asp-for="Password">🔑 Şifre</label>
                    <input asp-for="Password" class="xp-input" type="password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="xp-field-error"></span>
                </div>

                <div class="xp-form-group" style="display:flex; align-items:center; gap:6px;">
                    <input asp-for="RememberMe" type="checkbox" id="remember" />
                    <label for="remember" style="font-size:11px; cursor:pointer;">Beni Hatırla</label>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
                    <a href="/Account/Register" style="font-size:11px; color: var(--xp-link);">
                        Hesap oluştur →
                    </a>
                    <button type="submit" class="xp-btn xp-btn-primary" style="min-width:100px;">
                        ✅ Giriş Yap
                    </button>
                </div>
            </form>

            @* Admin bilgisi - sadece geliştirme/demo amaçlı *@
            <div style="margin-top:16px; padding:8px; background:#F5F3ED; border:1px dashed #ACA899; font-size:10px; color:#666;">
                <strong>Demo:</strong> admin@KurusMatik.com / Admin123!
            </div>
        </div>
    </div>
</div>
<script src="~/js/xp.js"></script>
</body>
</html>
