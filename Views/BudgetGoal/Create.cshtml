@model KurusMatik.Models.BudgetGoal
@{
    ViewData["Title"] = "Bütçe Hedefi Oluştur";
    var categories = ViewBag.Categories as List<KurusMatik.Models.Category> ?? new();
}

<div style="max-width:460px; margin:0 auto;">
    <div class="xp-window">
        <div class="xp-titlebar">
            <span class="xp-titlebar-icon">🎯</span>
            <span class="xp-titlebar-text">Yeni Bütçe Hedefi</span>
            <div class="xp-titlebar-buttons">
                <div class="xp-win-btn xp-win-btn-close" onclick="location.href='/BudgetGoal'">✕</div>
            </div>
        </div>
        <div class="xp-window-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="xp-alert xp-alert-danger">
                    <span class="xp-alert-icon">❌</span>
                    <div>@string.Join(" ", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))</div>
                </div>
            }

            <form asp-action="Create" asp-controller="BudgetGoal" method="post">
                @Html.AntiForgeryToken()

                <div class="xp-form-group">
                    <label class="xp-label" asp-for="CategoryId">📂 Kategori <span style="color:red;">*</span></label>
                    <select asp-for="CategoryId" class="xp-select">
                        <option value="">— Gider kategorisi seçin —</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="xp-field-error"></span>
                    <span style="font-size:10px; color:#666;">Sadece gider kategorileri için hedef oluşturulabilir.</span>
                </div>

                <div class="xp-form-group">
                    <label class="xp-label" asp-for="MonthlyLimit">💰 Aylık Limit (₺) <span style="color:red;">*</span></label>
                    <input asp-for="MonthlyLimit" class="xp-input" type="number" step="0.01" min="0.01"
                           placeholder="Örn: 2000.00" />
                    <span asp-validation-for="MonthlyLimit" class="xp-field-error"></span>
                </div>

                <div class="xp-grid xp-grid-2" style="gap:8px;">
                    <div class="xp-form-group">
                        <label class="xp-label" asp-for="StartDate">📅 Başlangıç <span style="color:red;">*</span></label>
                        <input asp-for="StartDate" class="xp-input" type="date" />
                        <span asp-validation-for="StartDate" class="xp-field-error"></span>
                    </div>
                    <div class="xp-form-group">
                        <label class="xp-label" asp-for="EndDate">📅 Bitiş (opsiyonel)</label>
                        <input asp-for="EndDate" class="xp-input" type="date" />
                    </div>
                </div>

                <div class="xp-flex-end mt-8">
                    <a href="/BudgetGoal" class="xp-btn">✖ İptal</a>
                    <button type="submit" class="xp-btn xp-btn-primary">💾 Hedef Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>
