@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model KurusMatik.ViewModels.TransactionViewModel
@{
    ViewData["Title"] = "İşlem Düzenle";
}

<div style="max-width:500px; margin:0 auto;">
    <div class="xp-window">
        <div class="xp-titlebar">
            <span class="xp-titlebar-icon">✏️</span>
            <span class="xp-titlebar-text">İşlem Düzenle — #@Model.Id</span>
            <div class="xp-titlebar-buttons">
                <div class="xp-win-btn xp-win-btn-close" onclick="location.href='/Transaction'">✕</div>
            </div>
        </div>
        <div class="xp-window-body">
            <form asp-action="Edit" asp-controller="Transaction" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div class="xp-form-group">
                    <label class="xp-label" asp-for="Amount">💰 Tutar (₺)</label>
                    <input asp-for="Amount" class="xp-input" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Amount" class="xp-field-error"></span>
                </div>
                <div class="xp-form-group">
                    <label class="xp-label" asp-for="CategoryId">📂 Kategori</label>
                    <select asp-for="CategoryId" class="xp-select">
                        @foreach (var cat in Model.AvailableCategories)
                        {
                        <option value="@cat.Id" @(cat.Id == Model.CategoryId ? "selected" : "")>
                            @cat.Name (@cat.Type)
                        </option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="xp-field-error"></span>
                </div>
                <div class="xp-form-group">
                    <label class="xp-label" asp-for="Date">📅 Tarih</label>
                    <input asp-for="Date" class="xp-input" type="date" />
                    <span asp-validation-for="Date" class="xp-field-error"></span>
                </div>
                <div class="xp-form-group">
                    <label class="xp-label" asp-for="Description">📝 Açıklama</label>
                    <input asp-for="Description" class="xp-input" />
                </div>

                <div class="xp-flex-end mt-8">
                    <a href="/Transaction" class="xp-btn">✖ İptal</a>
                    <button type="submit" class="xp-btn xp-btn-primary">💾 Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>
